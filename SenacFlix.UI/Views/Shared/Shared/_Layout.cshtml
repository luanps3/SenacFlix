<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SenacFlix</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <!-- Bootstrap 5 via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome (ícones de play, coração, etc.) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Design System SenacFlix -->
    <link rel="stylesheet" href="~/css/senacflix.css" asp-append-version="true" />
    <!-- Script de Tema (executado antes do body para evitar flicker) -->
    <script src="~/js/theme.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ═══════════════════════════════════════
         NAVBAR
         Transparente apenas na Home (hero).
         Em todas as outras páginas usa fundo sólido.
         A classe é controlada por JS no scroll e
         por ViewData["NavbarClass"] nas views.
         ═══════════════════════════════════════ -->
    <header>
        <nav id="mainNavbar"
             class="navbar navbar-expand-lg fixed-top @(ViewData["NavbarClass"] ?? "navbar-default-solid")">
            <div class="container-fluid px-4">

                <!-- Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="SenacFlix" />
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain"
                        aria-controls="navMain" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <!-- Links à esquerda -->
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        Painel Admin
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Filmes" asp-action="Index">
                                        Gerenciar Filmes
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                                        Gerenciar Categorias
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Cliente" asp-controller="Catalogo" asp-action="Index">
                                    Catálogo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Cliente" asp-controller="Favoritos" asp-action="Index">
                                    Meus Favoritos
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Links à direita -->
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3">
                            <a href="#" id="themeToggleBtn" class="nav-link d-flex align-items-center justify-content-center" title="Alternar Tema" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.1);">
                                <i id="themeToggleIcon" class="fa fa-moon"></i>
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                                   id="navDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @{
                                        var fotoClaim = User.Claims.FirstOrDefault(c => c.Type == "FotoPerfil")?.Value;
                                    }
                                    @if (!string.IsNullOrEmpty(fotoClaim))
                                    {
                                        <img src="@fotoClaim" alt="Avatar" class="rounded-circle me-2" style="width: 28px; height: 28px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-user-circle me-1"></i>
                                    }
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="navDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Perfil" asp-action="Index">
                                            <i class="fa fa-user-edit me-2"></i>Meu Perfil
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Conta" asp-action="Sair" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="fa fa-sign-out-alt me-2"></i>Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Conta" asp-action="Login">
                                    Entrar
                                </a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-senac-orange px-3 py-2 rounded"
                                   asp-area="" asp-controller="Conta" asp-action="Registrar">
                                    Criar Conta
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Conteúdo principal -->
    <!-- A Home injeta o hero sem o container; as demais views usam pt-5 para compensar a navbar fixed -->
    @if (ViewData["FullScreen"] as bool? == true)
    {
        <!-- Layout fullscreen: a view gerencia seu próprio espaçamento -->
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-5 z-3" role="alert" style="min-width:320px;">
                @TempData["Sucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-5 z-3" role="alert" style="min-width:320px;">
                @TempData["Erro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    }
    else
    {
        <div class="container pb-5 pt-5 mt-3">
            <main role="main" class="pb-3">
                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Sucesso"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Erro"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Erro"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    }

    <!-- Footer -->
    <footer class="border-top footer text-muted text-center py-3 mt-auto w-100">
        <div class="container">
            <img src="~/images/logo.png" alt="SenacFlix" style="height:28px;" class="mb-1" />
            <p class="mb-0 small text-muted">
                &copy; 2024 SenacFlix — Desenvolvido para fins didáticos.
            </p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Navbar scroll behavior (transparente → sólida) -->
    <script>
        (function () {
            var navbar = document.getElementById('mainNavbar');
            if (!navbar) return;
            var isTransparent = navbar.classList.contains('navbar-transparent');
            if (!isTransparent) return; // Só aplica scroll na Home

            function onScroll() {
                if (window.scrollY > 80) {
                    navbar.classList.remove('navbar-transparent');
                    navbar.classList.add('navbar-solid');
                } else {
                    navbar.classList.remove('navbar-solid');
                    navbar.classList.add('navbar-transparent');
                }
            }
            window.addEventListener('scroll', onScroll, { passive: true });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

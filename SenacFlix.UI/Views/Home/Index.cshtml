<!-- ══════════════════════════════════════════════════
     HERO FULLSCREEN — Mosaico de posters do catálogo animado
     ══════════════════════════════════════════════════ -->
<section class="hero-section">

    @{
        // Embaralha as capas para ser aleatório a cada reload
        var rnd = new Random();
        var capasEmbaralhadas = capas.OrderBy(x => rnd.Next()).ToArray();
        
        // Define as fatias para cada linha (12 filmes por linha)
        var row1 = capasEmbaralhadas.Take(12).ToArray();
        var row2 = capasEmbaralhadas.Skip(12).Take(12).ToArray();
        var row3 = capasEmbaralhadas.Skip(24).Take(12).ToArray();
        var row4 = capasEmbaralhadas.Skip(36).Take(12).ToArray();
    }

    <!-- Mosaico rotacionado animado -->
    <div class="hero-mosaic-container" aria-hidden="true">
        <!-- Linha 1: Esquerda -->
        <div class="hero-mosaic-row scroll-left">
            @foreach (var capa in row1.Concat(row1)) { <img src="@capa" alt="" loading="lazy" decoding="async" /> }
        </div>
        <!-- Linha 2: Direita -->
        <div class="hero-mosaic-row scroll-right">
            @foreach (var capa in row2.Concat(row2)) { <img src="@capa" alt="" loading="lazy" decoding="async" /> }
        </div>
        <!-- Linha 3: Esquerda -->
        <div class="hero-mosaic-row scroll-left">
            @foreach (var capa in row3.Concat(row3)) { <img src="@capa" alt="" loading="lazy" decoding="async" /> }
        </div>
        <!-- Linha 4: Direita -->
        <div class="hero-mosaic-row scroll-right">
            @foreach (var capa in row4.Concat(row4)) { <img src="@capa" alt="" loading="lazy" decoding="async" /> }
        </div>
    </div>

    <!-- Máscaras de gradiente -->
    <div class="hero-mask-center" aria-hidden="true"></div>
    <div class="hero-mask-top"    aria-hidden="true"></div>
    <div class="hero-mask-bottom" aria-hidden="true"></div>

    <!-- Conteúdo central -->
    <div class="hero-content">
        <img src="~/images/logo.png" alt="SenacFlix" class="hero-logo" />

        <h1 class="hero-title">
            Filmes, séries e muito<br>mais, sem limites
        </h1>

        <p class="hero-subtitle">
            Assista onde quiser. Cancele quando quiser.<br>
            Conteúdo premium com a qualidade Senac.
        </p>

        <div class="hero-actions">
            <a asp-controller="Conta" asp-action="Login"
               class="btn btn-nf-play px-5 py-3 fs-5 fw-bold">
                <i class="fa fa-sign-in-alt"></i> Entrar
            </a>
            <a asp-controller="Conta" asp-action="Registrar"
               class="btn btn-senac-orange px-5 py-3 fs-5 fw-bold rounded">
                Criar Conta &rsaquo;
            </a>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════
     FEATURES
     ══════════════════════════════════════════════════ -->
<section class="features-section">
    <div class="container">
        <div class="row g-5 text-center">

            <div class="col-md-4 feature-item">
                <div class="mb-3">
                    <i class="fa fa-tv fa-3x" style="color:var(--senac-orange)"></i>
                </div>
                <h4>Aproveite na TV</h4>
                <p>Assista em Smart TVs, PlayStation, Xbox, Chromecast, Apple TV e outros dispositivos.</p>
            </div>

            <div class="col-md-4 feature-item">
                <div class="mb-3">
                    <i class="fa fa-download fa-3x" style="color:var(--senac-orange)"></i>
                </div>
                <h4>Baixe para assistir offline</h4>
                <p>Salve seus títulos favoritos e assista mesmo quando não tiver internet.</p>
            </div>

            <div class="col-md-4 feature-item">
                <div class="mb-3">
                    <i class="fa fa-heart fa-3x" style="color:var(--senac-orange)"></i>
                </div>
                <h4>Crie perfis e favorite</h4>
                <p>Tenha sua própria lista de filmes favoritos salvos diretamente na sua conta.</p>
            </div>

        </div>
    </div>
</section>

@model SenacFlix.UI.ViewModels.RegistroViewModel
@{
    ViewData["Title"] = "Criar Conta — SenacFlix";
}

<div class="row justify-content-center" style="padding-top: 6rem;">
    <div class="col-md-6 col-sm-10">
        <div class="auth-card card shadow-lg">
            <div class="card-body">

                <!-- Logo -->
                <div class="text-center mb-4">
                    <img src="~/images/logo.png" alt="SenacFlix" class="auth-logo" />
                </div>

                <h2 class="fw-bold text-center mb-4">Criar Conta</h2>

                <form asp-action="Registrar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control" placeholder="Seu nome completo" />
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="E-mail" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataNascimento" class="form-label"></label>
                        <input asp-for="DataNascimento" type="date" class="form-control" />
                        <span asp-validation-for="DataNascimento" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" class="form-control" placeholder="Senha" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmarSenha" class="form-label"></label>
                            <input asp-for="ConfirmarSenha" class="form-control" placeholder="Confirmar senha" />
                            <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-senac-orange btn-lg fw-bold">
                            Criar Conta &rsaquo;
                        </button>
                    </div>
                </form>

                <div class="mt-4 text-center">
                    <p class="text-muted">
                        Já tem uma conta?
                        <a asp-action="Login" class="text-decoration-none fw-bold">
                            Entrar
                        </a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model SenacFlix.UI.ViewModels.CategoriaEdicaoViewModel

@{
    ViewData["Title"] = "Criar Categoria";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-senac-orange"><i class="fa fa-plus-circle me-2"></i>Nova Categoria</h2>
    <a asp-action="Index" class="btn btn-outline-light">
        <i class="fa fa-arrow-left me-1"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card bg-dark text-white shadow">
            <div class="card-body p-4">
                <form asp-action="Criar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label text-muted">Nome da Categoria</label>
                        <input asp-for="Nome" class="form-control bg-secondary text-white border-secondary" placeholder="Ex: Ação, Drama..." />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descricao" class="form-label text-muted">Descrição (Opcional)</label>
                        <textarea asp-for="Descricao" class="form-control bg-secondary text-white border-secondary" rows="3" placeholder="Descrição breve da categoria"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-senac-orange text-white fw-bold">
                            <i class="fa fa-save me-1"></i> Salvar Categoria
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}